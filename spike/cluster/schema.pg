// 確認用のスキーマ。設計書 (2026-11-19-zettelist-design.md) の変更後の形。
// 残りの項目は運用文書のとおり。

node Source {
  id: String @key
  slug: String
  title: String
  author: String?
  year: I32?
  kind: enum(book, paper, article, video, talk, other)
  url: String?
  input: String
  provenance: String
  accessed: Date?
}

node Fleeting {
  slug: String @key
  body: String
  created: DateTime
  embedding: Vector(1024)? @embed("body", model="qwen3-embedding:0.6b") @index
}

node Literature {
  slug: String @key
  body: String
  created: DateTime
  embedding: Vector(1024)? @embed("body", model="qwen3-embedding:0.6b") @index
}

node Permanent {
  slug: String @key
  title: String
  body: String
  created: DateTime
  embedding: Vector(1024)? @embed("body", model="qwen3-embedding:0.6b") @index
}

node Hub {
  slug: String @key
  title: String
}

edge Cites: Literature -> Source @card(1..1) {
  locator: String?
}
edge DerivedFrom: Permanent -> Fleeting
edge DerivedFromLit: Permanent -> Literature
edge Links: Permanent -> Permanent {
  reason: String?
  similarity: F32
}
edge Includes: Hub -> Permanent {
  position: I32?
}
